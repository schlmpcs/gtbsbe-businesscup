{
  "name": "lifeguessr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm tokens:check && eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:forecast": "vitest run --config apps/web/vitest.eval.config.ts",
    "e2e": "pnpm --filter web e2e",
    "tokens": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "data:refresh": "pnpm --filter @lifeguessr/data refresh",
    "fixtures:plan": "node scripts/fixtures-plan.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
