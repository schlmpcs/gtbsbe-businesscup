{
  "name": "lifeguessr",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "node scripts/check-ui.mjs && pnpm --dir apps/web lint",
    "test": "go test ./...",
    "test:race": "go test -race ./...",
    "api": "go run ./services/api/cmd/server",
    "tokens": "node scripts/tokens.mjs",
    "data:refresh": "node scripts/python.mjs packages/data/scripts/refresh.py",
    "e2e": "playwright test",
    "contracts": "go run ./services/api/cmd/contracts && openapi-typescript packages/contracts/openapi.json -o apps/web/src/lib/generated-api.ts",
    "test:csv": "node scripts/test-csv.mjs",
    "test:data": "node scripts/python.mjs -m unittest discover -s packages/data/scripts -p \"test_*.py\""
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "openapi-typescript": "^7.13.0"
  }
}
