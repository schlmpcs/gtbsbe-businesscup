{
  "$description": "Starter design tokens (neutral placeholder). Replace with the Figma variables export (D3), then run `pnpm tokens`. Groups map to Tailwind theme namespaces: color, font, text, leading, fontWeight, spacing, radius, shadow.",
  "color": {
    "bg": { "$type": "color", "$value": "#ffffff" },
    "surface": { "$type": "color", "$value": "#f6f7f9" },
    "surface-strong": { "$type": "color", "$value": "#eceef2" },
    "border": { "$type": "color", "$value": "#dfe2e8" },
    "text": { "$type": "color", "$value": "#15171c" },
    "text-muted": { "$type": "color", "$value": "#5b6170" },
    "primary": { "$type": "color", "$value": "#2f5bea" },
    "primary-hover": { "$type": "color", "$value": "#244acb" },
    "on-primary": { "$type": "color", "$value": "#ffffff" },
    "positive": { "$type": "color", "$value": "#1a7f4b" },
    "warning": { "$type": "color", "$value": "#b26b00" },
    "negative": { "$type": "color", "$value": "#c62f2f" },
    "focus": { "$type": "color", "$value": "{color.primary}" },
    "chart": {
      "1": { "$type": "color", "$value": "#2f5bea" },
      "2": { "$type": "color", "$value": "#e07b39" },
      "3": { "$type": "color", "$value": "#1a9e77" },
      "4": { "$type": "color", "$value": "#9b5de5" },
      "5": { "$type": "color", "$value": "#d1497b" },
      "6": { "$type": "color", "$value": "#6b7280" },
      "band": { "$type": "color", "$value": "#2f5bea33" },
      "grid": { "$type": "color", "$value": "#e5e7eb" }
    }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
  },
  "text": {
    "xs": { "$type": "dimension", "$value": "0.75rem" },
    "sm": { "$type": "dimension", "$value": "0.875rem" },
    "base": { "$type": "dimension", "$value": "1rem" },
    "lg": { "$type": "dimension", "$value": "1.125rem" },
    "xl": { "$type": "dimension", "$value": "1.25rem" },
    "2xl": { "$type": "dimension", "$value": "1.5rem" },
    "3xl": { "$type": "dimension", "$value": "1.875rem" },
    "4xl": { "$type": "dimension", "$value": "2.25rem" },
    "display": { "$type": "dimension", "$value": "3rem" }
  },
  "leading": {
    "tight": { "$type": "number", "$value": 1.2 },
    "normal": { "$type": "number", "$value": 1.5 }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": 4 },
    "sm": { "$type": "dimension", "$value": 8 },
    "md": { "$type": "dimension", "$value": 12 },
    "lg": { "$type": "dimension", "$value": 16 },
    "xl": { "$type": "dimension", "$value": 24 },
    "2xl": { "$type": "dimension", "$value": 32 },
    "3xl": { "$type": "dimension", "$value": 48 }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": 6 },
    "md": { "$type": "dimension", "$value": 10 },
    "lg": { "$type": "dimension", "$value": 16 },
    "full": { "$type": "dimension", "$value": 9999 }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": "0 1px 2px rgb(16 24 40 / 0.06)" },
    "md": { "$type": "shadow", "$value": "0 4px 12px rgb(16 24 40 / 0.08)" },
    "lg": { "$type": "shadow", "$value": "0 12px 32px rgb(16 24 40 / 0.12)" }
  }
}
