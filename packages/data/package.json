{
  "name": "@lifeguessr/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./areas": "./areas.ts",
    "./cards": "./cards.ts",
    "./fixtures": "./fixtures/index.ts",
    "./fixtures/cards": "./fixtures/cards.ts",
    "./fixtures/node": "./fixtures/node.ts",
    "./fixtures/*.json": "./fixtures/*.json",
    "./fixtures/*.csv": "./fixtures/*.csv",
    "./subscriptions": "./subscriptions.ts"
  },
  "scripts": {
    "refresh": "node ../../scripts/python.mjs scripts/refresh.py",
    "refresh:offline": "node ../../scripts/python.mjs scripts/refresh.py --offline",
    "import:ndcp": "node ../../scripts/python.mjs scripts/import-ndcp.py",
    "test:py": "node ../../scripts/python.mjs scripts/test_refresh.py",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@lifeguessr/types": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
