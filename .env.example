# Copy to .env (never commit .env). Names only here; values go in your local .env or the host's env settings.

# LLM (server-side only): Anthropic Claude for /api/ai/* and /api/statement/categorize.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Storage for sessions, leaderboard and events: a self-hosted store on the team's own server
# (implemented in T4/T5). Connection URL, including any credentials; keep it out of the repo.
STORE_URL=

# Public data refresh (T2, `pnpm data:refresh`).
HUD_TOKEN=
CENSUS_KEY=
BLS_KEY=

# Client feature flags (public, inlined at build time).
# Daily game source: `fixtures` (default) plays the fixture cards in the browser with the real
# engine; `api` uses /api/daily, /api/daily/clue and /api/daily/guess (T5).
NEXT_PUBLIC_GAME_SOURCE=fixtures
# Session save: `local` (default) keeps everything in localStorage; `api` also saves to
# POST /api/session (T4) and turns itself off if the route returns 404.
NEXT_PUBLIC_SESSION_SOURCE=local
