# Local: copy to .env and load it into your shell, or use Docker Compose.
DOMAIN=localhost
PUBLIC_ORIGIN=http://localhost:3000
APP_ENV=development
STORE_MODE=memory
DATABASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_ZDR_VERIFIED=false
API_ADDR=:8080
API_ORIGIN=http://127.0.0.1:8080
# Enable only behind an isolated trusted reverse proxy; API must not have a public port.
TRUST_PROXY=false
