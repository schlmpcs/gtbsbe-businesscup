# Copy to .env (never commit .env). Names only here; values go in your local .env or the host's env settings.

# LLM (server-side only): Anthropic Claude for /api/ai/* and /api/statement/categorize.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Model for the 10-year forecast (/api/ai/forecast). Blank = use ANTHROPIC_MODEL.
ANTHROPIC_FORECAST_MODEL=

# The store for sessions, Pro entitlements, leaderboard and events: Postgres (T4).
# Production (deploy/compose.yaml): set only STORE_PASSWORD, letters and digits, made with
# `openssl rand -hex 32`; compose builds STORE_URL from it for the bundled postgres service.
STORE_PASSWORD=
# Local dev: a postgres:// URL of your own database, e.g. postgres://user:pass@localhost:5432/db.
# Unset in dev = an in-memory store that forgets everything on restart. Unset in production =
# the session routes answer 503 (never a silent in-memory fallback).
STORE_URL=
# Tests only: a database the Postgres integration tests may write to (each test uses its own
# schema and drops it). Unset = those tests skip. CI sets it.
TEST_STORE_URL=

# Pro paywall demo (server-side only; no real money ever moves).
# Stripe TEST-mode secret or restricted key (sk_test_… / rk_test_…). A live key, anything else,
# or unset switches Stripe checkout off; the promo code still works.
STRIPE_SECRET_KEY=
# Public base URL Stripe returns the payer to, sub-path included, e.g. https://host/lifeguessr.
# Unset: derived from the request (x-forwarded-proto/-host). Required for a sub-path deploy.
APP_URL=
# Promo code shown on the Pro screen so the jury can unlock Pro without paying (default JURY-DEMO).
PRO_DEMO_CODE=
# `off` disables the promo code.
PRO_DEMO_UNLOCK=
# Directory of the entitlement file (default .data/pro, relative to the server's working directory),
# used when STORE_URL is unset. With STORE_URL, Pro lives in the store and this file is imported once.
PRO_DATA_DIR=

# Public data refresh (T2, `pnpm data:refresh`; see packages/data/README.md). All optional.
# BLS API v2 key (raises the daily query limit; without it the keyless v1 API is used).
BLS_KEY=
# Path to a downloaded HUD SAFMR workbook (fyNNNN_safmrs.xlsx) and its fiscal year, used instead
# of HUD's eGIS service, e.g. for a newer fiscal year.
HUD_XLSX=
HUD_FY=
# Python 3 executable for the pipeline (default: python3).
PYTHON=

# Client feature flags (public, inlined at build time).
# Daily game source: `fixtures` (default) plays the fixture cards in the browser with the real
# engine; `api` uses /api/daily, /api/daily/clue and /api/daily/guess (T5): the server scores and
# stores each guess (needs the store), which the leaderboard and the share cards read.
NEXT_PUBLIC_GAME_SOURCE=fixtures
# Session save: `local` (default) keeps everything in localStorage; `api` also saves the profile
# and wishlist to POST /api/session (T4, needs the store) and restores them when this browser has
# lost its app state but kept its anonymous id. It turns itself off if the route returns 404.
NEXT_PUBLIC_SESSION_SOURCE=local
# Funnel events: `off` (default) sends none; `api` sends them to POST /api/events (T8, needs the
# store), read back with GET /api/events/funnel. Browsers with Global Privacy Control or Do Not
# Track on send none either way.
NEXT_PUBLIC_EVENTS_SOURCE=off
